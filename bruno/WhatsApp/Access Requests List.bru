meta {
  name: Access Requests List
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/whatsapp/{{agentSlug}}/access-requests?status=1
  body: none
  auth: bearer
}

params:query {
  status: 1
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  agentSlug: ava
}

script:post-response {
  if (res.body && res.body.dados && res.body.dados.length) bru.setVar("whatsappAccessRequestId", res.body.dados[0].whatsappAccessRequestId);
}

docs {
  status: 1 = pendente, 2 = aprovada, 3 = rejeitada. Sem status = todas.
}
