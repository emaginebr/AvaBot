meta {
  name: Change Password
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/auth/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "nova-senha-12345"
  }
}
