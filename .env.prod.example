# Database
AVABOT_CONNECTION_STRING=Host=<DB_HOST>;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>

# WPP Connect
WPP_SECRET_KEY=<WPP_CONNECT_SECRET_KEY>

# Auth
AVABOT_USERNAME=<AVABOT_USERNAME>
AVABOT_PASSWORD=<AVABOT_PASSWORD>
AVABOT_JWT_SECRET=<AVABOT_JWT_SECRET>

# Power BI: chave AES-256 (32 bytes) em base64 para os client secrets dos agentes.
# Gere com `openssl rand -base64 32`. Nao reutilize a chave do ambiente de dev.
POWERBI_SECRET_ENCRYPTION_KEY=<32_BYTES_BASE64>
