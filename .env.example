# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=avabot
CONNECTION_STRING=Host=db;Database=avabot;Username=postgres;Password=your_password_here

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Auth
AVABOT_USERNAME=admin
AVABOT_PASSWORD=your_password_here
AVABOT_JWT_SECRET=your_jwt_secret_min_32_chars_here

# WPP Connect
WPP_SECRET_KEY=your_wpp_secret_key_here

# Power BI: chave AES-256 (32 bytes) em base64 usada para criptografar os client
# secrets dos agentes. Gere com `openssl rand -base64 32` ou, em PowerShell:
# [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])
# Vazio desliga a feature (as telas de Power BI retornam erro ao salvar credenciais).
POWERBI_SECRET_ENCRYPTION_KEY=

# App
APP_PORT=5000
